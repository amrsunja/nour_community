SUPABASE_URL=https:
SUPABASE_KEY=

# Stripe (publishable key only — the secret key lives in Supabase secrets)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google OAuth (native id-token flow -> Supabase signInWithIdToken)
# serverClientId = the "Web" OAuth client id from Google Cloud Console.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

